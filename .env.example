TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
# Optional: comma-separated Telegram user IDs allowed to use the bot.
# Leave empty while testing, but set it before deploying publicly.
ALLOWED_USER_IDS=
# Optional: where the SQLite file lives. On Railway, point this at your mounted volume, e.g. /data/events.db
DB_PATH=./data/events.db
