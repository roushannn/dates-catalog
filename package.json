{
  "name": "weekend-events-bot",
  "version": "1.0.0",
  "description": "Telegram bot that tracks events and offers forwarded or added by the user, for quick lookup on date nights and weekends.",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.0.1",
    "better-sqlite3": "^11.3.0",
    "chrono-node": "^2.7.7",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
